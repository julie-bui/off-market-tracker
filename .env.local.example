# Supabase project credentials (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Shared invite code for /signup (server-only — do not use NEXT_PUBLIC_)
INVITE_CODE=your-shared-invite-code

# MapTiler API key (Cloud → Keys) for MapLibre streets basemap
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key
